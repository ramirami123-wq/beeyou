{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
  }

  .ai-editorial-{{ ai_gen_id }}__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid {{ block.settings.border_color }};
    margin-bottom: 28px;
  }

  .ai-editorial-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 8px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }}, serif;
    font-size: clamp(30px, 5vw, 64px);
    font-weight: 400;
    line-height: 0.98;
  }

  .ai-editorial-{{ ai_gen_id }}__intro {
    max-width: 360px;
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
  }

  .ai-editorial-{{ ai_gen_id }}__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(260px, 0.85fr);
    gap: 28px;
  }

  .ai-editorial-{{ ai_gen_id }}__feature,
  .ai-editorial-{{ ai_gen_id }}__story {
    min-width: 0;
  }

  .ai-editorial-{{ ai_gen_id }}__media {
    position: relative;
    overflow: hidden;
    background: {{ block.settings.placeholder_color }};
    aspect-ratio: 1.35 / 1;
  }

  .ai-editorial-{{ ai_gen_id }}__feature .ai-editorial-{{ ai_gen_id }}__media {
    aspect-ratio: 1.45 / 1;
  }

  .ai-editorial-{{ ai_gen_id }}__media img,
  .ai-editorial-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-{{ ai_gen_id }}__placeholder-text {
    position: absolute;
    right: 16px;
    bottom: 14px;
    left: 16px;
    color: #5a5a5a;
    font-size: 13px;
    text-align: center;
  }

  .ai-editorial-{{ ai_gen_id }}__content {
    padding-top: 18px;
  }

  .ai-editorial-{{ ai_gen_id }}__tag {
    margin: 0 0 8px;
    color: {{ block.settings.accent_color }};
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__story-title {
    margin: 0 0 10px;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }}, serif;
    font-size: 25px;
    font-weight: 400;
    line-height: 1.08;
  }

  .ai-editorial-{{ ai_gen_id }}__feature .ai-editorial-{{ ai_gen_id }}__story-title {
    font-size: clamp(30px, 4vw, 48px);
  }

  .ai-editorial-{{ ai_gen_id }}__excerpt {
    margin: 0 0 16px;
    font-size: 15px;
    line-height: 1.5;
  }

  .ai-editorial-{{ ai_gen_id }}__link {
    display: inline-flex;
    color: {{ block.settings.heading_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    border-bottom: 1px solid {{ block.settings.heading_color }};
    padding-bottom: 3px;
  }

  .ai-editorial-{{ ai_gen_id }}__stories {
    display: grid;
    gap: 26px;
  }

  .ai-editorial-{{ ai_gen_id }}__story {
    display: grid;
    grid-template-columns: 42% 1fr;
    gap: 16px;
    padding-bottom: 26px;
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-editorial-{{ ai_gen_id }}__story:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .ai-editorial-{{ ai_gen_id }}__story .ai-editorial-{{ ai_gen_id }}__media {
    aspect-ratio: 1 / 1;
  }

  .ai-editorial-{{ ai_gen_id }}__story .ai-editorial-{{ ai_gen_id }}__content {
    padding-top: 0;
  }

  .ai-editorial-{{ ai_gen_id }}__story .ai-editorial-{{ ai_gen_id }}__story-title {
    font-size: 21px;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-{{ ai_gen_id }}__header {
      display: block;
    }

    .ai-editorial-{{ ai_gen_id }}__intro {
      margin-top: 16px;
    }

    .ai-editorial-{{ ai_gen_id }}__layout {
      display: block;
    }

    .ai-editorial-{{ ai_gen_id }}__feature {
      margin-bottom: 36px;
    }

    .ai-editorial-{{ ai_gen_id }}__story {
      grid-template-columns: 38% 1fr;
    }
  }
{% endstyle %}

<article class="ai-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <header class="ai-editorial-{{ ai_gen_id }}__header">
    <div>
      {% if block.settings.eyebrow != blank %}<p class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
      <h2 class="ai-editorial-{{ ai_gen_id }}__title">{{ block.settings.title }}</h2>
    </div>
    {% if block.settings.intro != blank %}<p class="ai-editorial-{{ ai_gen_id }}__intro">{{ block.settings.intro }}</p>{% endif %}
  </header>

  <div class="ai-editorial-{{ ai_gen_id }}__layout">
    <article class="ai-editorial-{{ ai_gen_id }}__feature">
      <a href="{{ block.settings.feature_link }}" class="ai-editorial-{{ ai_gen_id }}__media" aria-label="{{ block.settings.feature_title | escape }}">
        {% if block.settings.feature_image %}
          <img src="{{ block.settings.feature_image | image_url: width: 1600 }}" alt="{{ block.settings.feature_image.alt | escape }}" loading="lazy" width="{{ block.settings.feature_image.width }}" height="{{ block.settings.feature_image.height }}">
        {% else %}
          {{ 'image' | placeholder_svg_tag }}
          <span class="ai-editorial-{{ ai_gen_id }}__placeholder-text">Add a feature image</span>
        {% endif %}
      </a>
      <div class="ai-editorial-{{ ai_gen_id }}__content">
        {% if block.settings.feature_tag != blank %}<p class="ai-editorial-{{ ai_gen_id }}__tag">{{ block.settings.feature_tag }}</p>{% endif %}
        <h3 class="ai-editorial-{{ ai_gen_id }}__story-title">{{ block.settings.feature_title }}</h3>
        {% if block.settings.feature_excerpt != blank %}<p class="ai-editorial-{{ ai_gen_id }}__excerpt">{{ block.settings.feature_excerpt }}</p>{% endif %}
        {% if block.settings.feature_link != blank %}<a class="ai-editorial-{{ ai_gen_id }}__link" href="{{ block.settings.feature_link }}">{{ block.settings.link_label }}</a>{% endif %}
      </div>
    </article>

    <div class="ai-editorial-{{ ai_gen_id }}__stories">
      {% for i in (1..2) %}
        {% liquid
          assign image_key = 'story_' | append: i | append: '_image'
          assign tag_key = 'story_' | append: i | append: '_tag'
          assign title_key = 'story_' | append: i | append: '_title'
          assign excerpt_key = 'story_' | append: i | append: '_excerpt'
          assign link_key = 'story_' | append: i | append: '_link'
          assign story_image = block.settings[image_key]
          assign story_tag = block.settings[tag_key]
          assign story_title = block.settings[title_key]
          assign story_excerpt = block.settings[excerpt_key]
          assign story_link = block.settings[link_key]
        %}
        <article class="ai-editorial-{{ ai_gen_id }}__story">
          <a href="{{ story_link }}" class="ai-editorial-{{ ai_gen_id }}__media" aria-label="{{ story_title | escape }}">
            {% if story_image %}<img src="{{ story_image | image_url: width: 700 }}" alt="{{ story_image.alt | escape }}" loading="lazy" width="{{ story_image.width }}" height="{{ story_image.height }}">{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}
          </a>
          <div class="ai-editorial-{{ ai_gen_id }}__content">
            {% if story_tag != blank %}<p class="ai-editorial-{{ ai_gen_id }}__tag">{{ story_tag }}</p>{% endif %}
            <h3 class="ai-editorial-{{ ai_gen_id }}__story-title">{{ story_title }}</h3>
            {% if story_excerpt != blank %}<p class="ai-editorial-{{ ai_gen_id }}__excerpt">{{ story_excerpt }}</p>{% endif %}
            {% if story_link != blank %}<a class="ai-editorial-{{ ai_gen_id }}__link" href="{{ story_link }}">{{ block.settings.link_label }}</a>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Editorial magazine",
  "settings": [
    {"type":"header","content":"Layout"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"The journal"},
    {"type":"text","id":"title","label":"Title","default":"Stories worth sharing"},
    {"type":"textarea","id":"intro","label":"Introduction","default":"Thoughtful notes, fresh ideas, and inspiration from our world."},
    {"type":"text","id":"link_label","label":"Link label","default":"Read story"},
    {"type":"header","content":"Feature story"},
    {"type":"image_picker","id":"feature_image","label":"Image"},
    {"type":"text","id":"feature_tag","label":"Tag","default":"Featured"},
    {"type":"text","id":"feature_title","label":"Title","default":"A closer look at what inspires us"},
    {"type":"textarea","id":"feature_excerpt","label":"Excerpt","default":"Discover the ideas, details, and people behind our latest story."},
    {"type":"url","id":"feature_link","label":"Link"},
    {"type":"header","content":"Story one"},
    {"type":"image_picker","id":"story_1_image","label":"Image"},
    {"type":"text","id":"story_1_tag","label":"Tag","default":"In focus"},
    {"type":"text","id":"story_1_title","label":"Title","default":"Small details, lasting impact"},
    {"type":"textarea","id":"story_1_excerpt","label":"Excerpt","default":"The thoughtful choices that make a difference."},
    {"type":"url","id":"story_1_link","label":"Link"},
    {"type":"header","content":"Story two"},
    {"type":"image_picker","id":"story_2_image","label":"Image"},
    {"type":"text","id":"story_2_tag","label":"Tag","default":"Field notes"},
    {"type":"text","id":"story_2_title","label":"Title","default":"Ideas for a more considered life"},
    {"type":"textarea","id":"story_2_excerpt","label":"Excerpt","default":"Simple inspiration for everyday rituals."},
    {"type":"url","id":"story_2_link","label":"Link"},
    {"type":"header","content":"Colors"},
    {"type":"color","id":"background_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text","default":"#212326"},
    {"type":"color","id":"heading_color","label":"Headings","default":"#1a1b18"},
    {"type":"color","id":"accent_color","label":"Accent","default":"#ff024e"},
    {"type":"color","id":"border_color","label":"Borders","default":"#d2d5d9"},
    {"type":"color","id":"placeholder_color","label":"Placeholder","default":"#f3f3f3"},
    {"type":"font_picker","id":"heading_font","label":"Heading font","default":"serif"}
  ],
  "presets": [{"name":"Editorial magazine"}],
  "tag": null,
  "class": "editorial-magazine-block"
}
{% endschema %}