{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
  }

  .ai-editorial-{{ ai_gen_id }}__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 18px;
    margin-bottom: 24px;
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-editorial-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 8px;
    color: {{ block.settings.accent_color }};
    font-family: {{ block.settings.body_font.family }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.05;
  }

  .ai-editorial-{{ ai_gen_id }}__intro {
    max-width: 420px;
    margin: 0;
    font-family: {{ block.settings.body_font.family }};
    font-size: 15px;
    line-height: 1.55;
    text-align: right;
  }

  .ai-editorial-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(240px, 1fr);
    gap: 24px;
  }

  .ai-editorial-{{ ai_gen_id }}__lead,
  .ai-editorial-{{ ai_gen_id }}__story {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ai-editorial-{{ ai_gen_id }}__lead-image,
  .ai-editorial-{{ ai_gen_id }}__story-image,
  .ai-editorial-{{ ai_gen_id }}__placeholder {
    overflow: hidden;
    background: {{ block.settings.image_background }};
  }

  .ai-editorial-{{ ai_gen_id }}__lead-image,
  .ai-editorial-{{ ai_gen_id }}__placeholder--lead {
    aspect-ratio: 1.35 / 1;
  }

  .ai-editorial-{{ ai_gen_id }}__story-image,
  .ai-editorial-{{ ai_gen_id }}__placeholder--story {
    aspect-ratio: 1.35 / 1;
  }

  .ai-editorial-{{ ai_gen_id }}__lead-image img,
  .ai-editorial-{{ ai_gen_id }}__story-image img,
  .ai-editorial-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-{{ ai_gen_id }}__placeholder {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-{{ ai_gen_id }}__placeholder svg {
    max-width: 70%;
    color: {{ block.settings.border_color }};
  }

  .ai-editorial-{{ ai_gen_id }}__meta {
    margin: 16px 0 8px;
    color: {{ block.settings.accent_color }};
    font-family: {{ block.settings.body_font.family }};
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__lead-heading {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-size: {{ block.settings.lead_size }}px;
    line-height: 1.08;
  }

  .ai-editorial-{{ ai_gen_id }}__excerpt {
    margin: 12px 0 0;
    font-family: {{ block.settings.body_font.family }};
    font-size: 15px;
    line-height: 1.5;
  }

  .ai-editorial-{{ ai_gen_id }}__side {
    display: grid;
    gap: 24px;
  }

  .ai-editorial-{{ ai_gen_id }}__story {
    display: grid;
    grid-template-columns: 42% 1fr;
    gap: 16px;
    align-items: start;
  }

  .ai-editorial-{{ ai_gen_id }}__story .ai-editorial-{{ ai_gen_id }}__meta {
    margin-top: 0;
  }

  .ai-editorial-{{ ai_gen_id }}__story-heading {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-size: 21px;
    line-height: 1.12;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-{{ ai_gen_id }}__header {
      display: block;
    }

    .ai-editorial-{{ ai_gen_id }}__intro {
      margin-top: 14px;
      text-align: left;
    }

    .ai-editorial-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
    }

    .ai-editorial-{{ ai_gen_id }}__lead-heading {
      font-size: {{ block.settings.lead_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<editorial-layout-{{ ai_gen_id }} class="ai-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-{{ ai_gen_id }}__header">
    <div>
      {% if block.settings.eyebrow != blank %}<p class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
      <h2 class="ai-editorial-{{ ai_gen_id }}__title">{{ block.settings.title }}</h2>
    </div>
    {% if block.settings.intro != blank %}<p class="ai-editorial-{{ ai_gen_id }}__intro">{{ block.settings.intro }}</p>{% endif %}
  </div>

  <div class="ai-editorial-{{ ai_gen_id }}__grid">
    {% assign lead = block.settings.lead_article %}
    <a class="ai-editorial-{{ ai_gen_id }}__lead" href="{% if lead != blank %}{{ lead.url }}{% else %}#{% endif %}">
      {% if lead != blank and lead.image %}
        <div class="ai-editorial-{{ ai_gen_id }}__lead-image"><img src="{{ lead.image | image_url: width: 1400 }}" alt="{{ lead.image.alt | default: lead.title | escape }}" loading="lazy" width="{{ lead.image.width }}" height="{{ lead.image.height }}"></div>
      {% else %}
        <div class="ai-editorial-{{ ai_gen_id }}__placeholder ai-editorial-{{ ai_gen_id }}__placeholder--lead">{{ 'image' | placeholder_svg_tag }}</div>
      {% endif %}
      <p class="ai-editorial-{{ ai_gen_id }}__meta">{{ block.settings.lead_label }}</p>
      <h3 class="ai-editorial-{{ ai_gen_id }}__lead-heading">{% if lead != blank %}{{ lead.title }}{% else %}Add a lead article{% endif %}</h3>
      {% if lead != blank and lead.excerpt != blank %}<p class="ai-editorial-{{ ai_gen_id }}__excerpt">{{ lead.excerpt | strip_html | truncate: 150 }}</p>{% endif %}
    </a>

    <div class="ai-editorial-{{ ai_gen_id }}__side">
      {% for article in block.settings.secondary_articles %}
        <a class="ai-editorial-{{ ai_gen_id }}__story" href="{{ article.url }}">
          {% if article.image %}<div class="ai-editorial-{{ ai_gen_id }}__story-image"><img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy" width="{{ article.image.width }}" height="{{ article.image.height }}"></div>{% else %}<div class="ai-editorial-{{ ai_gen_id }}__placeholder ai-editorial-{{ ai_gen_id }}__placeholder--story">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
          <div><p class="ai-editorial-{{ ai_gen_id }}__meta">{{ block.settings.secondary_label }}</p><h3 class="ai-editorial-{{ ai_gen_id }}__story-heading">{{ article.title }}</h3></div>
        </a>
      {% endfor %}
    </div>
  </div>
</editorial-layout-{{ ai_gen_id }}>

<script>
  (function() {
    class EditorialLayout{{ ai_gen_id }} extends HTMLElement {}
    if (!customElements.get('editorial-layout-{{ ai_gen_id }}')) customElements.define('editorial-layout-{{ ai_gen_id }}', EditorialLayout{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Magazine editorial",
  "tag": null,
  "class": "magazine-editorial-block",
  "settings": [
    {"type":"header","content":"Content"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"The journal"},
    {"type":"text","id":"title","label":"Title","default":"Stories worth sharing"},
    {"type":"textarea","id":"intro","label":"Introduction","default":"Discover thoughtful stories, useful ideas, and the latest from our world."},
    {"type":"article","id":"lead_article","label":"Lead article"},
    {"type":"product_list","id":"secondary_articles","label":"Secondary products","limit":2},
    {"type":"text","id":"lead_label","label":"Lead label","default":"Featured story"},
    {"type":"text","id":"secondary_label","label":"Secondary label","default":"From the journal"},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"heading_size","label":"Heading size","min":24,"max":72,"step":4,"unit":"px","default":44},
    {"type":"range","id":"lead_size","label":"Lead title size","min":26,"max":64,"step":2,"unit":"px","default":42},
    {"type":"header","content":"Colors and fonts"},
    {"type":"font_picker","id":"heading_font","label":"Heading font","default":"serif"},
    {"type":"font_picker","id":"body_font","label":"Body font","default":"sans-serif"},
    {"type":"color","id":"background_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"heading_color","label":"Headings","default":"#1a1b18"},
    {"type":"color","id":"text_color","label":"Text","default":"#212326"},
    {"type":"color","id":"accent_color","label":"Accent","default":"#ff024e"},
    {"type":"color","id":"border_color","label":"Borders","default":"#d2d5d9"},
    {"type":"color","id":"image_background","label":"Image background","default":"#f3f3f3"}
  ],
  "presets": [{"name":"Magazine editorial"}]
}
{% endschema %}